# Local development defaults. Copy values into backend/.env and frontend/.env.local.
# Replace all placeholders with your own credentials. Never commit actual .env files.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_workspace
SUPABASE_JWT_SECRET=replace-me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
GEMINI_API_KEY=replace-me
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
